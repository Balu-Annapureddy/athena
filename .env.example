# Athena Platform — Environment Variables
#
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` file — it is listed in .gitignore.
#
# Usage (local development):
#   $env:TELEGRAM_BOT_TOKEN = "..."   (PowerShell)
#   export TELEGRAM_BOT_TOKEN="..."   (bash/zsh)
#
# Usage (GitHub Actions):
#   Set all secrets under Settings → Secrets and variables → Actions.
#   They are mapped into the workflow via `env:` blocks in daily_signal.yml.

# ── Telegram Notifications ────────────────────────────────────────────────────
# Obtained from @BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=

# Your personal or group chat ID.
# Obtain via https://api.telegram.org/bot<TOKEN>/getUpdates after sending any
# message to the bot, or use the @userinfobot helper.
TELEGRAM_CHAT_ID=

# ── Athena REST API Authentication ───────────────────────────────────────────
# An arbitrary secret bearer token for the Athena HTTP API.
# Generated locally, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Set this in the SecretsRepository / os.environ for the API server to validate.
ATHENA_API_KEY=

# ── Dev / CI Bypass Switches ─────────────────────────────────────────────────
# Set to "true" to skip bearer-token validation entirely (local dev / CI only).
# Must NEVER be "true" in a production or paper-trading environment.
ATHENA_AUTH_BYPASS=false
